# USO — Unified Script Orchestrator
# Required environment variables

# Master key for Fernet encryption of secrets (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
USO_MASTER_KEY=

# Database path (default: data/uso.db)
USO_DB_PATH=data/uso.db

# Log level (DEBUG, INFO, WARNING, ERROR)
USO_LOG_LEVEL=INFO
